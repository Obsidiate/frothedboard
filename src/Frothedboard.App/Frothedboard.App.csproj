<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets this Windows-only project restore its ref packs and build on Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>frothedboard</AssemblyName>
    <RootNamespace>Frothedboard.App</RootNamespace>
    <ApplicationIcon>frothedboard.ico</ApplicationIcon>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Frothedboard.Core\Frothedboard.Core.csproj" />
    <!-- Same file the exe wears, embedded so the tray icon is sharp at every size Windows asks
         for rather than a scaled-down 32x32. -->
    <EmbeddedResource Include="frothedboard.ico" LogicalName="frothedboard.ico" />
  </ItemGroup>

</Project>
